<%- layout('./layouts/boilerplate.ejs') -%>
<body>
<div class="row">
    <div class="col-8 offset-2" >
        <h3>Edit Listing</h3>

<form action="/listings/<%= listing._id %>?_method=PUT" method="POST">
    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" class="from-control" value="<%= listing.title %>">
    </div>
    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control"><%= listing.description %></textarea>
    </div>

    <div class="mb-3">
        <label for="image" class="form-label">Image</label>
        <input type="text" name="listing[image][filename]" class="form-control" value="<%= listing.image.filename %>">
        <input type="text" name="listing[image][url]" class="form-control" value="<%= listing.image.url %>">
    </div>
    <div class="row">
    <div class="mb-3 col-md-4">
        <label for="price" class="form-label">Price</label>
        <input type="number" name="listing[price]" class="form-control" value="<%= listing.price %>">
    </div>
    <div class="mb-3 col-md-8">
        <label for="location" class="form-label">Location</label>
        <input type="text" name="listing[location]" class="form-control" value="<%= listing.location %>">
    </div>
    </div>
    <div class="mb-3">
        <label for="country" class="form-label">Country</label>
        <input type="text" name="listing[country]" class="form-control" value="<%= listing.country %>">
    </div>

<button class="btn btn-dark add-btn">Edit</button>

</form>
</div>
</div>
</body>
</html>
</body>
</html>