<% layout('./layouts/boilerplate.ejs') -%>
<body>
    <div class="row">
        <div class="col-8 offset-2" >

      
    <h3 class="mt-2">Lisiting Details</h3>

    <div class="card col-10">
        <img src="<%= listing.image.url %>" class="card-img-top show-img"  alt="...">
        <div class="card-body">
            <p class="card-text">
                <b><%= listing.title %></b><br>
                <%= listing.description %> <br>
                &#8377;<%= listing.price.toLocaleString("en-IN") %> <br>
                <%= listing.location %> <br>
                <%= listing.country %>
            </p>
        </div>
    </div>
         
        </div>
    </div>
    <div class="btns">
            <a class="btn btn-dark  offset-2 " href="/listings/<%= listing.id %>/edit">Edit</a>
            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="mt-1 btn btn-dark  offset-2 ">Delete</button>
            </form>
     </div>
</body>
</html>